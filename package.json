{
  "name": "hotel-reservation-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @hrms/api start:dev",
    "dev:web": "pnpm --filter @hrms/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @hrms/api test:e2e",
    "prisma:generate": "pnpm --filter @hrms/api prisma:generate",
    "prisma:migrate": "pnpm --filter @hrms/api prisma:migrate",
    "prisma:seed": "pnpm --filter @hrms/api prisma:seed",
    "audit": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "js-yaml@<5": "^4.3.2",
      "glob@10": "^10.5.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.7",
      "lodash": "^4.18.1",
      "tmp": "^0.2.4"
    }
  }
}
