# ---- Core ----
NODE_ENV=development
PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Database ----
DATABASE_URL=postgresql://hrms_app:changeme@localhost:5432/hrms?schema=public
DATABASE_SHADOW_URL=postgresql://hrms_app:changeme@localhost:5432/hrms_shadow?schema=public
POSTGRES_USER=hrms_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hrms

# ---- Redis / Queues ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-64-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=replace-with-a-random-32-byte-secret

# ---- Payment provider (abstraction, no real credentials) ----
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-signing-secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- Observability ----
LOG_LEVEL=info
